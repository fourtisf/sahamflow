[Unit]
Description=Sahamflow API (FastAPI/gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=sahamflow
Group=sahamflow
WorkingDirectory=/opt/sahamflow/backend
Environment=ENABLE_SCHEDULER=0
EnvironmentFile=/opt/sahamflow/backend/.env
ExecStart=/opt/sahamflow/backend/.venv/bin/gunicorn app.main:app -c /opt/sahamflow/deploy/gunicorn_conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
