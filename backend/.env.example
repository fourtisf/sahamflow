# Database (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://sahamflow:sahamflow@localhost:5432/sahamflow

# Redis (narrative cache)
REDIS_URL=redis://localhost:6379/0

# Anthropic — leave blank to run without AI narratives
ANTHROPIC_API_KEY=
# Use the latest available model. Sonnet is the cost-effective default for narratives.
CLAUDE_MODEL=claude-sonnet-4-6

APP_ENV=development
# Working universe pilihan:
#   "lq45"      — 45 saham paling likuid (default, fast)
#   "kompas100" — 100 saham KOMPAS100 (broader smart-money)
#   "combined"  — LQ45 ∪ KOMPAS100 (~110 unique, recommended untuk coverage maks)
#   "seed"      — 10 saham quick-test only
UNIVERSE=lq45
# SBN 10Y yield (%) — no Yahoo feed; set manually so the regime yield factor is real
# SBN_10Y=6.78

# Telegram alerts for high-conviction setups (optional). Create a bot via
# @BotFather, send /start to it, then get your chat_id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portfolio risk defaults
ACCOUNT_SIZE_IDR=500000000
TIMEZONE=Asia/Jakarta
ALLOWED_HOSTS=*

# Cost control for AI narratives
NARRATIVE_TOP_N=50
NARRATIVE_CACHE_TTL=86400

# === Smart filter / hedge fund discipline ===
# Min R:R untuk lolos alert (default 2.0 = 1:2). Setup di bawah ini auto-reject.
MIN_RR_RATIO=2.0
# Cooldown per ticker (hari). Hindari spam signal sama berturut-turut.
COOLDOWN_DAYS=3
# Watchlist optional. Kalau diisi, HANYA ticker ini yang kirim alert.
# Contoh: WATCHLIST_TICKERS=BBRI,ANTM,TLKM,BBCA
WATCHLIST_TICKERS=
